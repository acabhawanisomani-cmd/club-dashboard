# Copy to .streamlit/secrets.toml for local runs, and paste the same keys into
# Streamlit Cloud → Settings → Secrets for the deployed app.

# Neon: use the POOLED connection string from Neon's Connect dialog
# (tick "Connection pooling"). Never edit the host by hand.
DATABASE_URL = "postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/dbname?sslmode=require"

# Shared club passcode. Anyone can READ without it; adding, editing and
# deleting require it. Leave it out entirely to make the app fully open.
APP_PASSCODE = "choose-something-and-share-it-in-the-club-group"

CLUB_NAME = "Investment Club"
